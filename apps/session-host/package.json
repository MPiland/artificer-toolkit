{
  "name": "@artificer-toolkit/session-host",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "yarn --cwd ../.. vitest run --config vitest.config.ts apps/session-host/src",
    "test:local": "tsx integration/localPlay.ts",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "typecheck:integration": "tsc -p tsconfig.integration.json"
  },
  "dependencies": {
    "@artificer-toolkit/db": "workspace:^",
    "@artificer-toolkit/functions": "workspace:^",
    "@artificer-toolkit/schema": "workspace:^",
    "@colyseus/core": "0.17.50",
    "@colyseus/schema": "4.0.30",
    "@colyseus/ws-transport": "0.17.13",
    "express": "5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@colyseus/sdk": "0.17.43",
    "@supabase/supabase-js": "2.108.2",
    "@types/express": "5.0.6",
    "@types/node": "^25.6.1",
    "tsx": "^4.22.4",
    "typescript": "^7.0.2"
  }
}
