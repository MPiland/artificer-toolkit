{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "types": [
      "vite/client"
    ],
    "noEmit": true,
    "useDefineForClassFields": true,
    "module": "esnext",
    "moduleResolution": "bundler"
  },
  "include": [
    "src",
    "vite.config.ts",
    "vite-env.d.ts"
  ]
}
