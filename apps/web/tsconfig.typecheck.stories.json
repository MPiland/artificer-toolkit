{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": true,
    "noEmit": true,
    "tsBuildInfoFile": ".cache/tsc/typecheck.stories.tsbuildinfo",
    "types": [
      "vite/client",
      "node",
      "vitest/globals",
      "@testing-library/jest-dom"
    ]
  },
  "include": [
    ".storybook/**/*",
    "src/routeTree.gen.ts",
    "src/**/*.stories.ts",
    "src/**/*.stories.tsx",
    "vite-env.d.ts"
  ]
}
