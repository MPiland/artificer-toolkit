{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "baseUrl": "src",
    "paths": {
      "@/components/*": ["components/*"],
      "@/pages/*": ["pages/*"],
      "@/types": ["types/index.ts"],
      "@/types/*": ["types/*"],
      "@/enums": ["enums/enums.ts"],
      "@/hooks": ["hooks/index.ts"],
      "@/utils": ["utils/index.ts"],
      "@/css/*": ["css/*"],
      "@/routes/*": ["routes/*"],
      "@/apis/*": ["apis/*"],
      "@/assets/*": ["assets/*"],
      "@/theme/*": ["theme/*"],
      "@/store": ["store/index.ts"],
      "@/store/*": ["store/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules/**/*", "./dist/**/*", ".amplify/**/*"],
  "references": [{ "path": "tsconfig.server.json" }]
}
