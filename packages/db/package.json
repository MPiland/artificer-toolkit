{
  "name": "@artificer-toolkit/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#types": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/types/index.js"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/types/index.js"
    },
    "./types/column-meta": {
      "types": "./dist/types/column-meta.d.ts",
      "default": "./dist/types/column-meta.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "yarn --cwd ../.. vitest run --config vitest.config.ts packages/db/src/__tests__",
    "test:authored-creation-rate-limit:integration": "tsx src/scripts/testAuthoredCreationRateLimitIntegration.ts",
    "generate:bootstrap-bundle": "node ./scripts/build-create-database-bundle.mjs",
    "db:reset:remote": "tsx src/scripts/resetRemotePublicSchema.ts",
    "social:retention": "tsx src/scripts/purgeSocialRetention.ts",
    "audit:srd": "yarn audit:srd:semantic && tsx src/scripts/auditSrdData.ts",
    "audit:srd:semantic": "tsx src/scripts/auditSrdSemanticLedger.ts",
    "audit:srd:staging": "tsx src/scripts/auditSrdData.ts --staging",
    "audit:srd:production": "tsx src/scripts/auditSrdData.ts --production",
    "test:character-sheet:integration": "tsx src/scripts/testCharacterSheetStatePatchIntegration.ts",
    "test:srd:integration": "tsx src/scripts/testSrdIntegration.ts",
    "seed:srd:local": "tsx src/scripts/seedSrd.ts --local",
    "seed-owner:staging": "tsx src/scripts/seedOwner.ts --staging",
    "seed-owner:production": "tsx src/scripts/seedOwner.ts --production",
    "seed:srd:staging:dry-run": "tsx src/scripts/seedSrd.ts --staging --dry-run",
    "seed:srd:staging": "tsx src/scripts/seedSrd.ts --staging --confirm-seed-srd",
    "seed:srd:production:dry-run": "tsx src/scripts/seedSrd.ts --production --dry-run",
    "seed:srd:production": "tsx src/scripts/seedSrd.ts --production --confirm-seed-srd",
    "gen:types": "supabase gen types --local --lang typescript --schema public,storage > src/types/supabase.database.ts && tsx src/scripts/normalizeGeneratedSupabaseTypes.ts"
  },
  "dependencies": {
    "@artificer-toolkit/schema": "workspace:^",
    "@artificer-toolkit/shared": "workspace:^",
    "@supabase/supabase-js": "^2.108.2",
    "kysely": "^0.28.17",
    "kysely-supabase": "^0.2.1",
    "pg": "^8.20.0",
    "supabase": "^2.111.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "tsx": "^4.22.4",
    "typescript": "^7.0.2"
  }
}
