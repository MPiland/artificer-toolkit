{
  "name": "@artificer-toolkit/rules-runtime",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "@artificer-toolkit/schema": "workspace:^",
    "@artificer-toolkit/shared": "workspace:^",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
