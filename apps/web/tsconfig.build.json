{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": [
      "vite/client",
      "node",
      "vitest/globals",
      "vitest/browser",
      "@testing-library/jest-dom"
    ]
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.browser.config.ts",
    "playwright.config.ts",
    ".storybook/**/*",
    "src/app/**/*",
    "src/css/**/*",
    "src/router.tsx",
    "src/server.ts",
    "src/supabase/**/*",
    "src/test/**/*",
    "vite-env.d.ts"
  ]
}
