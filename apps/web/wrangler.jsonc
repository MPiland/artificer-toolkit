{
  // The web app Worker: TanStack Start SSR plus the /api/auth proxy (ADR 0037). It is separate from
  // the session Worker so a web deploy or rollback never touches the live room. Deploys run only
  // through the manual workflow; see docs/runbooks/web-worker-hosting.md.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "artificer-web",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  // Local dev and preview read these from the process environment (vite.config.ts loads the root
  // env file); deployed environments set them with `wrangler secret put`.
  "secrets": {
    "required": ["AUTH_PROXY_SECRET", "CONVEX_SITE_URL"]
  },
  "env": {
    "staging": {
      "name": "artificer-web-staging",
      "workers_dev": false,
      "preview_urls": false,
      "secrets": {
        "required": ["AUTH_PROXY_SECRET", "CONVEX_SITE_URL"]
      }
    }
  }
}
