{
  "name": "@artificer-toolkit/encounter-persistence",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./*": {
      "source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test": "yarn --cwd ../.. vitest run --config vitest.config.ts packages/encounter-persistence/src"
  },
  "dependencies": {
    "@artificer-toolkit/rules-runtime": "workspace:^",
    "@artificer-toolkit/schema": "workspace:^",
    "@artificer-toolkit/shared": "workspace:^",
    "zod": "4.5.3"
  },
  "devDependencies": {
    "convex": "1.48.0",
    "typescript": "^7.0.2"
  }
}
