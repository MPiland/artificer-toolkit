{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "composite": true,
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "paths": {
            "@db-types": [
                "./src/types/index.ts"
            ]
        },
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "outDir": "dist",
        "rootDir": "src",
        "stripInternal": true,
        "noEmit": false
    },
    "include": [
        "src"
    ],
    "exclude": [
        "dist"
    ]
}
