{
  "name": "@artificer-toolkit/shared",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/types/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "default": "./dist/schemas/index.js"
    }
  },
  "imports": {
    "#core": {
      "types": "./dist/barrels/core/index.d.ts",
      "default": "./dist/barrels/core/index.js"
    },
    "#authored": {
      "types": "./dist/barrels/authored/index.d.ts",
      "default": "./dist/barrels/authored/index.js"
    },
    "#compilers": {
      "types": "./dist/barrels/compilers/index.d.ts",
      "default": "./dist/barrels/compilers/index.js"
    },
    "#utils": {
      "types": "./dist/utils/index.d.ts",
      "default": "./dist/utils/index.js"
    },
    "#maps": {
      "types": "./dist/barrels/maps/index.d.ts",
      "default": "./dist/barrels/maps/index.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@artificer-toolkit/db": "workspace:^"
  },
  "devDependencies": {
    "type-fest": "^5.4.4",
    "zod": "^4.3.6"
  }
}
