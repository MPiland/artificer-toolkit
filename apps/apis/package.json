{
  "name": "@artificer-toolkit/apis",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "yarn --cwd ../.. vitest run --config vitest.config.ts apps/apis/src",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "@artificer-toolkit/db": "workspace:^",
    "@artificer-toolkit/functions": "workspace:^",
    "@artificer-toolkit/schema": "workspace:^",
    "@artificer-toolkit/shared": "workspace:^",
    "@supabase/supabase-js": "^2.108.2",
    "@trpc/server": "^11.17.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./trpc-handler": {
      "types": "./dist/trpc/handler.d.ts",
      "default": "./dist/trpc/handler.js"
    },
    "./application-config": {
      "types": "./dist/applicationConfig.d.ts",
      "default": "./dist/applicationConfig.js"
    }
  }
}
