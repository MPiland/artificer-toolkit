{
  "name": "@artificer-toolkit/apis",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./auth-proxy-context": "./convex/lib/authProxyContext.ts",
    "./convex/definition-references": "./convex/content/definitionReferences.ts",
    "./convex/api": {
      "types": "./convex/_generated/api.d.ts",
      "default": "./convex/_generated/api.js"
    }
  },
  "scripts": {
    "generate:srd:manifest": "yarn --cwd ../.. exec tsx --conditions source apps/apis/scripts/generateSrdManifest.ts",
    "dev:convex": "yarn generate:srd:manifest && convex dev",
    "codegen:convex": "convex codegen",
    "codegen:auth": "auth generate --config better-auth.config.ts --output convex/betterAuth/schema.ts --yes",
    "seed:srd:convex:local": "node scripts/convexRunLocal.mjs content/seed:seed",
    "audit:srd:convex:local": "node scripts/convexRunLocal.mjs content/seed:audit",
    "typecheck:convex": "tsc -p convex/tsconfig.json --noEmit",
    "test:convex": "yarn --cwd ../.. vitest run --config apps/apis/vitest.config.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "yarn --cwd ../.. vitest run --config vitest.config.ts apps/apis/src",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "@artificer-toolkit/authoring": "workspace:^",
    "@artificer-toolkit/emails": "workspace:^",
    "@artificer-toolkit/encounter-persistence": "workspace:^",
    "@artificer-toolkit/rules-runtime": "workspace:^",
    "@artificer-toolkit/schema": "workspace:^",
    "@artificer-toolkit/shared": "workspace:^",
    "@artificer-toolkit/source-data": "workspace:^",
    "@aws-sdk/client-s3": "3.1159.0",
    "@aws-sdk/s3-request-presigner": "3.1159.0",
    "@convex-dev/better-auth": "0.12.6",
    "@convex-dev/migrations": "0.3.7",
    "@convex-dev/r2": "0.10.4",
    "@convex-dev/rate-limiter": "0.4.2",
    "@convex-dev/resend": "0.2.10",
    "better-auth": "patch:better-auth@npm%3A1.6.33#~/.yarn/patches/better-auth-npm-1.6.33-041d1c7111.patch",
    "convex": "1.48.0",
    "convex-helpers": "^0.1.131",
    "jose": "6.2.14",
    "sharp": "^0.35.5",
    "uuid": "^14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@convex-dev/action-retrier": "0.3.1",
    "auth": "1.6.33",
    "convex-test": "0.0.60",
    "react": "^19.3.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.156.0"
  },
  "installConfig": {
    "hoistingLimits": "workspaces"
  }
}
