{
  "name": "@artificer-toolkit/authoring",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./nodeRuntime": {
      "source": "./src/nodeRuntime/index.ts",
      "types": "./dist/nodeRuntime/index.d.ts",
      "default": "./dist/nodeRuntime/index.js"
    },
    "./nodeRuntime/authoredSourceFacts": {
      "source": "./src/nodeRuntime/authoredSourceFacts.ts",
      "types": "./dist/nodeRuntime/authoredSourceFacts.d.ts",
      "default": "./dist/nodeRuntime/authoredSourceFacts.js"
    },
    "./tests/srdSourceReader": {
      "source": "./src/tests/srdSourceReader.ts",
      "types": "./dist/tests/srdSourceReader.d.ts",
      "default": "./dist/tests/srdSourceReader.js"
    },
    "./imports": {
      "source": "./src/imports/index.ts",
      "types": "./dist/imports/index.d.ts",
      "default": "./dist/imports/index.js"
    },
    "./reusableDefinitions": {
      "source": "./src/reusableDefinitions/index.ts",
      "types": "./dist/reusableDefinitions/index.d.ts",
      "default": "./dist/reusableDefinitions/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "yarn --cwd ../.. vitest run --config vitest.config.ts packages/authoring/src",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.tests.json --noEmit"
  },
  "dependencies": {
    "@artificer-toolkit/schema": "workspace:^",
    "@artificer-toolkit/shared": "workspace:^",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@artificer-toolkit/rules-runtime": "workspace:^",
    "@artificer-toolkit/source-data": "workspace:^",
    "typescript": "^7.0.2"
  }
}
