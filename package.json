{
  "name": "artificer-toolkit",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "dev:prepare": "yarn workspace @artificer-toolkit/apis build",
    "dev": "yarn dev:prepare && turbo run dev --filter=@artificer-toolkit/web",
    "turbo": "turbo",
    "db:reset:remote": "yarn workspace @artificer-toolkit/db db:reset:remote",
    "audit:srd": "yarn workspace @artificer-toolkit/db audit:srd",
    "audit:srd:production": "yarn workspace @artificer-toolkit/db audit:srd:production",
    "test:character-sheet:integration": "yarn build:shared && yarn workspace @artificer-toolkit/db test:character-sheet:integration",
    "test:character:integration": "yarn build:db && tsx packages/functions/src/scripts/testCharacterLifecycleIntegration.ts",
    "test:srd:integration": "yarn build:schema && yarn build:shared && yarn workspace @artificer-toolkit/db test:srd:integration",
    "seed:owner": "yarn workspace @artificer-toolkit/db seed:owner",
    "seed:srd": "yarn build:shared && yarn workspace @artificer-toolkit/db seed:srd",
    "seed:srd:bulk:production:dry-run": "yarn workspace @artificer-toolkit/db seed:srd:bulk:production:dry-run",
    "seed:srd:bulk:production": "yarn workspace @artificer-toolkit/db seed:srd:bulk:production",
    "build:schema": "turbo run build --filter=@artificer-toolkit/schema",
    "build:design-system": "turbo run build --filter=@artificer-toolkit/design-system",
    "build:emails": "turbo run build --filter=@artificer-toolkit/emails",
    "typecheck:netlify": "tsc -p netlify/tsconfig.json",
    "generate:schema": "yarn workspace @artificer-toolkit/schema generate:zod",
    "build:web": "turbo run build --filter=@artificer-toolkit/emails --filter=@artificer-toolkit/web",
    "typecheck:web:diagnostics": "yarn workspace @artificer-toolkit/web typecheck:diagnostics",
    "storybook:web": "turbo run storybook --filter=@artificer-toolkit/web",
    "build-storybook:web": "turbo run build-storybook --filter=@artificer-toolkit/web",
    "build:apis": "turbo run build --filter=@artificer-toolkit/apis",
    "build:shared": "turbo run build --filter=@artificer-toolkit/shared",
    "build:db": "turbo run build --filter=@artificer-toolkit/db",
    "build:functions": "turbo run build --filter=@artificer-toolkit/functions",
    "build:functions:fast": "yarn tsc -p packages/functions/tsconfig.build.json --declarationMap false --sourceMap false",
    "typecheck:functions:services": "yarn tsc -p packages/functions/tsconfig.services.json --pretty false --noEmit",
    "build:functions:verbose": "yarn tsc --build packages/functions/tsconfig.build.json --verbose --extendedDiagnostics",
    "build:all": "turbo run build --filter=@artificer-toolkit/schema --filter=@artificer-toolkit/shared --filter=@artificer-toolkit/db --filter=@artificer-toolkit/functions --filter=@artificer-toolkit/apis",
    "test:shared": "turbo run test --filter=@artificer-toolkit/shared",
    "test:emails": "turbo run test --filter=@artificer-toolkit/emails",
    "test:shared:watch": "vitest packages/shared/src/__tests__",
    "test:schema": "turbo run test --filter=@artificer-toolkit/schema",
    "test:schema:watch": "vitest packages/schema/src/__tests__",
    "test:db": "turbo run test --filter=@artificer-toolkit/db",
    "test:db:watch": "vitest packages/db/src/__tests__",
    "test:web": "turbo run test --filter=@artificer-toolkit/web",
    "test:web:coverage": "turbo run test:coverage --filter=@artificer-toolkit/web",
    "test:web:coverage:storybook": "turbo run test:coverage:storybook --filter=@artificer-toolkit/web",
    "test:web:storybook": "turbo run test:storybook --filter=@artificer-toolkit/web",
    "test:web:e2e": "turbo run test:e2e --filter=@artificer-toolkit/web",
    "turbo:test:authoring": "turbo run test:authoring --filter=@artificer-toolkit/web",
    "turbo:typecheck:web:app": "turbo run typecheck:app --filter=@artificer-toolkit/web",
    "turbo:typecheck:web": "turbo run typecheck:app typecheck:tests --filter=@artificer-toolkit/web",
    "turbo:affected:test": "turbo run test --filter=\"[HEAD]\"",
    "turbo:affected:typecheck": "turbo run typecheck --filter=\"[HEAD]\"",
    "lint": "yarn lint:ox",
    "lint:ox": "oxlint --deny-warnings",
    "lint:ox:type-aware": "yarn lint:ox:type-aware:design-system && yarn lint:ox:type-aware:emails && yarn lint:ox:type-aware:netlify && yarn lint:ox:type-aware:schema && yarn lint:ox:type-aware:shared && yarn lint:ox:type-aware:db && yarn lint:ox:type-aware:functions && yarn lint:ox:type-aware:apis && yarn lint:ox:type-aware:web",
    "lint:ox:type-aware:design-system": "oxlint packages/design-system --type-aware --tsconfig packages/design-system/tsconfig.json --deny-warnings",
    "lint:ox:type-aware:emails": "oxlint packages/emails --type-aware --tsconfig packages/emails/tsconfig.json --deny-warnings",
    "lint:ox:type-aware:netlify": "oxlint netlify --type-aware --tsconfig netlify/tsconfig.json --deny-warnings",
    "lint:ox:type-aware:schema": "oxlint packages/schema --type-aware --tsconfig packages/schema/tsconfig.json --deny-warnings",
    "lint:ox:type-aware:shared": "oxlint packages/shared --type-aware --tsconfig packages/shared/tsconfig.json --deny-warnings",
    "lint:ox:type-aware:db": "oxlint packages/db --type-aware --tsconfig packages/db/tsconfig.json --deny-warnings",
    "lint:ox:type-aware:functions": "oxlint packages/functions --type-aware --tsconfig packages/functions/tsconfig.json --deny-warnings",
    "lint:ox:type-aware:apis": "oxlint apps/apis --type-aware --tsconfig apps/apis/tsconfig.json --deny-warnings",
    "lint:ox:type-aware:web": "oxlint apps/web --type-aware --tsconfig apps/web/tsconfig.json --deny-warnings",
    "lint:ox:type-aware:timings:design-system": "oxlint packages/design-system --type-aware --tsconfig packages/design-system/tsconfig.json --deny-warnings --debug=timings",
    "lint:ox:type-aware:timings:schema": "oxlint packages/schema --type-aware --tsconfig packages/schema/tsconfig.json --deny-warnings --debug=timings",
    "lint:ox:type-aware:timings:shared": "oxlint packages/shared --type-aware --tsconfig packages/shared/tsconfig.json --deny-warnings --debug=timings",
    "lint:ox:type-aware:timings:db": "oxlint packages/db --type-aware --tsconfig packages/db/tsconfig.json --deny-warnings --debug=timings",
    "lint:ox:type-aware:timings:functions": "oxlint packages/functions --type-aware --tsconfig packages/functions/tsconfig.json --deny-warnings --debug=timings",
    "lint:ox:type-aware:timings:apis": "oxlint apps/apis --type-aware --tsconfig apps/apis/tsconfig.json --deny-warnings --debug=timings",
    "lint:ox:type-aware:timings:web": "oxlint apps/web --type-aware --tsconfig apps/web/tsconfig.json --deny-warnings --debug=timings",
    "lint:shared": "oxlint packages/shared --deny-warnings",
    "lint:web": "oxlint apps/web --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "format:sql": "prettier --write \"supabase/**/*.sql\" \"packages/db/**/*.sql\""
  },
  "dependencies": {
    "@artificer-toolkit/emails": "workspace:^",
    "@artificer-toolkit/web": "workspace:^",
    "@chromatic-com/storybook": "^5.2.1",
    "@supabase/supabase-js": "^2.108.2",
    "kysely": "^0.28.17"
  },
  "devDependencies": {
    "@types/node": "^25.6.1",
    "@typescript/analyze-trace": "^0.11.0",
    "gitpick": "^5.4.1",
    "netlify-cli": "^26.2.0",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "oxlint-tsgolint": "^0.23.0",
    "prettier": "^3.8.3",
    "prettier-plugin-sql": "^0.20.0",
    "prettier-plugin-sql-cst": "^0.22.1",
    "rimraf": "^6.1.3",
    "supabase": "^2.109.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "turbo": "^2.9.16",
    "vitest": "^4.1.9"
  },
  "packageManager": "yarn@4.17.1"
}
