{
  "name": "@artificer-toolkit/web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "generate-routes": "tsr generate",
    "watch-routes": "tsr watch",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "yarn generate-routes && yarn typecheck:app",
    "typecheck:app": "node --max-old-space-size=8192 ../../node_modules/typescript/bin/tsc -p tsconfig.typecheck.app.json --pretty false",
    "typecheck:stories": "node --max-old-space-size=8192 ../../node_modules/typescript/bin/tsc -p tsconfig.typecheck.stories.json --pretty false",
    "typecheck:tests": "node --max-old-space-size=8192 ../../node_modules/typescript/bin/tsc -p tsconfig.typecheck.tests.json --pretty false",
    "typecheck:config": "node --max-old-space-size=8192 ../../node_modules/typescript/bin/tsc -p tsconfig.typecheck.config.json --pretty false",
    "typecheck:diagnostics": "node --max-old-space-size=8192 ../../node_modules/typescript/bin/tsc -p tsconfig.typecheck.app.json --extendedDiagnostics --pretty false",
    "test": "vitest run --config vitest.config.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "storybook": "storybook dev -p 6006 --ci",
    "build-storybook": "storybook build",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:storybook": "playwright test --project=storybook",
    "test:e2e:app": "playwright test --project=app"
  },
