{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": [
      "vite/client",
      "node",
      "vitest/globals",
      "vitest/browser",
      "@testing-library/jest-dom"
    ]
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/tests/**/*",
    "src/test/**/*",
    "vite-env.d.ts"
  ]
}
