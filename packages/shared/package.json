{
  "name": "@artificer-toolkit/shared",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#core": {
      "types": "./dist/barrels/core/index.d.ts",
      "default": "./dist/barrels/core/index.js"
    },
    "#authored": {
      "types": "./dist/barrels/authored/index.d.ts",
      "default": "./dist/barrels/authored/index.js"
    },
    "#compilers": {
      "types": "./dist/barrels/compilers/index.d.ts",
      "default": "./dist/barrels/compilers/index.js"
    },
    "#utils": {
      "types": "./dist/utils/index.d.ts",
      "default": "./dist/utils/index.js"
    },
    "#maps": {
      "types": "./dist/barrels/maps/index.d.ts",
      "default": "./dist/barrels/maps/index.js"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "default": "./dist/utils/index.js"
    },
    "./utils/authoringLimits": {
      "types": "./dist/utils/authoringLimits.d.ts",
      "default": "./dist/utils/authoringLimits.js"
    },
    "./authored": {
      "types": "./dist/barrels/authored/index.d.ts",
      "default": "./dist/barrels/authored/index.js"
    },
    "./compilers": {
      "types": "./dist/barrels/compilers/index.d.ts",
      "default": "./dist/barrels/compilers/index.js"
    },
    "./core": {
      "types": "./dist/barrels/core/index.d.ts",
      "default": "./dist/barrels/core/index.js"
    },
    "./maps": {
      "types": "./dist/barrels/maps/index.d.ts",
      "default": "./dist/barrels/maps/index.js"
    },
    "./character": {
      "types": "./dist/domains/character/index.d.ts",
      "default": "./dist/domains/character/index.js"
    },
    "./rolls": {
      "types": "./dist/domains/rolls/index.d.ts",
      "default": "./dist/domains/rolls/index.js"
    },
    "./rules": {
      "types": "./dist/domains/rules/index.d.ts",
      "default": "./dist/domains/rules/index.js"
    },
    "./vtt": {
      "types": "./dist/domains/vtt/index.d.ts",
      "default": "./dist/domains/vtt/index.js"
    },
    "./account/username": {
      "types": "./dist/domains/account/usernamePolicy.d.ts",
      "default": "./dist/domains/account/usernamePolicy.js"
    },
    "./campaign/textPolicy": {
      "types": "./dist/domains/campaign/campaignTextPolicy.d.ts",
      "default": "./dist/domains/campaign/campaignTextPolicy.js"
    },
    "./subjects/authored": {
      "types": "./dist/domains/subjects/authored/index.d.ts",
      "default": "./dist/domains/subjects/authored/index.js"
    },
    "./subjects/compilers": {
      "types": "./dist/domains/subjects/compilers/index.d.ts",
      "default": "./dist/domains/subjects/compilers/index.js"
    },
    "./subjects/core": {
      "types": "./dist/domains/subjects/core/index.d.ts",
      "default": "./dist/domains/subjects/core/index.js"
    },
    "./subjects/maps": {
      "types": "./dist/domains/subjects/maps/index.d.ts",
      "default": "./dist/domains/subjects/maps/index.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "yarn --cwd ../.. vitest run --config vitest.config.ts packages/shared/src/__tests__"
  },
  "dependencies": {
    "@2toad/profanity": "^3.3.0",
    "@artificer-toolkit/design-system": "workspace:^",
    "polygon-clipping": "0.15.7",
    "rbush": "4.0.1",
    "robust-predicates": "3.0.3"
  },
  "devDependencies": {
    "@types/rbush": "4.0.0",
    "fast-check": "4.9.0",
    "type-fest": "^5.6.0",
    "typescript": "^7.0.2",
    "zod": "^4.4.3"
  }
}
