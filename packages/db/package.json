{
  "name": "@artificer-toolkit/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/types/index.js"
    },
    "./types/column-meta": {
      "types": "./dist/types/column-meta.d.ts",
      "default": "./dist/types/column-meta.js"
    }
  },
  "imports": {
    "#types": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/types/index.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run src/__tests__",
    "build:create-db-bundle": "node ./scripts/build-create-database-bundle.mjs",
    "db:reset:remote": "tsx src/scripts/resetRemotePublicSchema.ts",
    "audit:srd": "tsx src/scripts/auditSrdData.ts",
    "seed:owner": "tsx src/scripts/seedOwner.ts",
    "seed:srd": "tsx src/scripts/seedSrd.ts",
    "gen:types": "supabase gen types typescript --project-id cvxfhtkksdeiycxpryhy --schema public,storage > src/types/supabase.database.ts"
  },
  "dependencies": {
    "@artificer-toolkit/schema": "workspace:^",
    "@artificer-toolkit/shared": "workspace:^",
    "@supabase/supabase-js": "^2.108.2",
    "kysely": "^0.28.17",
    "kysely-supabase": "^0.2.1",
    "pg": "^8.20.0",
    "supabase": "^2.101.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "tsx": "^4.22.4",
    "uuid": "^14.0.0"
  }
}
