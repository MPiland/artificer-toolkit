{
  "name": "@artificer-toolkit/session-worker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "build:staging": "yarn check:deployed-config && wrangler deploy --env staging --dry-run --outdir dist-staging",
    "check:deployed-config": "node scripts/assertNoLocalMarker.mjs",
    "deploy:staging": "yarn check:deployed-config && wrangler deploy --env staging --keep-vars",
    "deploy:production": "yarn check:deployed-config && wrangler deploy --keep-vars",
    "dev": "wrangler dev --host localhost",
    "preflight:managed": "node scripts/managedPreflight.mjs",
    "test": "vitest run --config vitest.config.ts --maxWorkers=1 --no-isolate",
    "test:unit": "yarn --cwd ../.. vitest run --config vitest.config.ts apps/session-worker/src --maxWorkers=1 --no-file-parallelism",
    "typecheck": "yarn types && tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit",
    "types": "wrangler types src/worker-configuration.d.ts --env-file=.dev.vars.example"
  },
  "dependencies": {
    "@artificer-toolkit/authoring": "workspace:^",
    "@artificer-toolkit/encounter-persistence": "workspace:^",
    "@artificer-toolkit/rules-runtime": "workspace:^",
    "@artificer-toolkit/schema": "workspace:^",
    "@artificer-toolkit/shared": "workspace:^",
    "jose": "^6.2.14",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@artificer-toolkit/source-data": "workspace:^",
    "@cloudflare/vitest-plugin": "1.4.10",
    "typescript": "^7.0.2",
    "uuid": "^14.0.3",
    "vitest": "^4.1.12",
    "wrangler": "4.147.0"
  }
}
