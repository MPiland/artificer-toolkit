{
  "name": "artificer-toolkit",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "dev:prepare": "yarn build:apis && yarn workspace @artificer-toolkit/apis generate:srd:manifest",
    "dev": "yarn dev:prepare && turbo run dev --filter=@artificer-toolkit/web",
    "turbo": "turbo",
    "social:retention:convex": "tsx apps/apis/src/scripts/socialRetention.ts",
    "build:schema": "turbo run build --filter=@artificer-toolkit/schema",
    "build:design-system": "turbo run build --filter=@artificer-toolkit/design-system",
    "build:emails": "turbo run build --filter=@artificer-toolkit/emails",
    "generate:schema": "yarn workspace @artificer-toolkit/schema generate:zod",
    "build:web": "turbo run build --filter=@artificer-toolkit/emails --filter=@artificer-toolkit/web",
    "typecheck:web:diagnostics": "yarn workspace @artificer-toolkit/web typecheck:diagnostics",
    "storybook:web": "turbo run storybook --filter=@artificer-toolkit/web",
    "build-storybook:web": "turbo run build-storybook --filter=@artificer-toolkit/web",
    "build:apis": "turbo run build --filter=@artificer-toolkit/apis",
    "build:shared": "turbo run build --filter=@artificer-toolkit/shared",
    "build:session-worker": "turbo run build --filter=@artificer-toolkit/session-worker",
    "build:session-worker:staging": "yarn workspace @artificer-toolkit/session-worker build:staging",
    "deploy:session-worker:staging": "yarn workspace @artificer-toolkit/session-worker deploy:staging",
    "deploy:session-worker:production": "yarn workspace @artificer-toolkit/session-worker deploy:production",
    "build:all": "turbo run build --filter=@artificer-toolkit/schema --filter=@artificer-toolkit/shared --filter=@artificer-toolkit/apis --filter=@artificer-toolkit/web --filter=@artificer-toolkit/session-worker",
    "validate:pre-staging:local": "node scripts/validatePreStagingLocal.mjs",
    "dev:session-worker": "yarn workspace @artificer-toolkit/session-worker dev",
    "preflight:session-worker:managed": "yarn workspace @artificer-toolkit/session-worker preflight:managed",
    "test:shared": "turbo run test --filter=@artificer-toolkit/shared",
    "test:emails": "turbo run test --filter=@artificer-toolkit/emails",
    "test:shared:watch": "vitest packages/shared/src/__tests__",
    "test:schema": "turbo run test --filter=@artificer-toolkit/schema",
    "test:schema:watch": "vitest packages/schema/src/__tests__",
    "test:web": "turbo run test --filter=@artificer-toolkit/web",
    "test:web:coverage": "turbo run test:coverage --filter=@artificer-toolkit/web",
    "test:web:coverage:storybook": "turbo run test:coverage:storybook --filter=@artificer-toolkit/web",
    "test:web:storybook": "turbo run test:storybook --filter=@artificer-toolkit/web",
    "test:web:e2e": "turbo run test:e2e --filter=@artificer-toolkit/web",
    "test:web:e2e:vtt-load": "yarn workspace @artificer-toolkit/web test:e2e:vtt-load",
    "test:web:e2e:vtt-load:hardware": "yarn workspace @artificer-toolkit/web test:e2e:vtt-load:hardware",
    "test:web:e2e:vtt-managed": "yarn workspace @artificer-toolkit/web test:e2e:vtt-managed",
    "test:web:e2e:vtt-local": "yarn workspace @artificer-toolkit/web test:e2e:vtt-local",
    "test:web:e2e:vtt-managed:release": "yarn preflight:session-worker:managed && yarn test:web:e2e:vtt-managed",
    "turbo:test:authoring": "turbo run test:authoring --filter=@artificer-toolkit/web",
    "turbo:typecheck:web:app": "turbo run typecheck:app --filter=@artificer-toolkit/web",
    "turbo:typecheck:web": "turbo run typecheck:app typecheck:tests --filter=@artificer-toolkit/web",
    "lint": "yarn lint:ox && yarn lint:schemas && yarn lint:casts && yarn lint:exports && yarn lint:ratchets",
    "lint:casts": "node scripts/doubleCasts.mjs",
    "lint:exports": "node scripts/unusedExports.mjs",
    "lint:ox": "oxlint --deny-warnings",
    "lint:ratchets": "node scripts/sourceRatchets.mjs",
    "lint:schemas": "node scripts/lazySchemas.mjs --check",
    "lint:ox:type-aware": "yarn lint:ox:type-aware:design-system && yarn lint:ox:type-aware:emails && yarn lint:ox:type-aware:schema && yarn lint:ox:type-aware:shared && yarn lint:ox:type-aware:apis && yarn lint:ox:type-aware:web",
    "lint:ox:type-aware:design-system": "oxlint packages/design-system --type-aware --tsconfig packages/design-system/tsconfig.json --deny-warnings",
    "lint:ox:type-aware:emails": "oxlint packages/emails --type-aware --tsconfig packages/emails/tsconfig.json --deny-warnings",
    "lint:ox:type-aware:schema": "oxlint packages/schema --type-aware --tsconfig packages/schema/tsconfig.json --deny-warnings",
    "lint:ox:type-aware:shared": "oxlint packages/shared --type-aware --tsconfig packages/shared/tsconfig.json --deny-warnings",
    "lint:ox:type-aware:apis": "oxlint apps/apis --type-aware --tsconfig apps/apis/tsconfig.json --deny-warnings",
    "lint:ox:type-aware:web": "oxlint apps/web --type-aware --tsconfig apps/web/tsconfig.json --deny-warnings",
    "lint:ox:type-aware:timings:design-system": "oxlint packages/design-system --type-aware --tsconfig packages/design-system/tsconfig.json --deny-warnings --debug=timings",
    "lint:ox:type-aware:timings:schema": "oxlint packages/schema --type-aware --tsconfig packages/schema/tsconfig.json --deny-warnings --debug=timings",
    "lint:ox:type-aware:timings:shared": "oxlint packages/shared --type-aware --tsconfig packages/shared/tsconfig.json --deny-warnings --debug=timings",
    "lint:ox:type-aware:timings:apis": "oxlint apps/apis --type-aware --tsconfig apps/apis/tsconfig.json --deny-warnings --debug=timings",
    "lint:ox:type-aware:timings:web": "oxlint apps/web --type-aware --tsconfig apps/web/tsconfig.json --deny-warnings --debug=timings",
    "lint:shared": "oxlint packages/shared --deny-warnings",
    "lint:web": "oxlint apps/web --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@chromatic-com/storybook": "^5.4.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "5.0.0",
    "@types/node": "^25.6.1",
    "@typescript/analyze-trace": "^0.11.1",
    "oxc-parser": "^0.153.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "turbo": "^2.11.7",
    "vitest": "^4.1.11"
  },
  "resolutions": {
    "@convex-dev/react-query@npm:0.1.0": "patch:@convex-dev/react-query@npm%3A0.1.0#~/.yarn/patches/convex-react-query-npm-0.1.0-stale-query-removal.patch",
    "convex@npm:1.46.0": "patch:convex@npm%3A1.46.0#~/.yarn/patches/convex-npm-1.46.0-4174a5f4e7.patch"
  },
  "packageManager": "yarn@4.18.1"
}
