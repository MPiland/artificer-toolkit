    "@tiptap/starter-kit": "3.22.5",
    "@trpc/client": "^11.17.0",
    "@trpc/server": "^11.17.0",
    "@vanilla-extract/css": "^1.20.1",
    "@vanilla-extract/recipes": "^0.5.7",
    "@vanilla-extract/sprinkles": "^1.6.5",
    "clsx": "^2.1.1",
    "html-react-parser": "^6.1.0",
    "lucide-react": "^1.14.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
