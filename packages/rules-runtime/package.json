{
  "name": "@artificer-toolkit/rules-runtime",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test": "yarn --cwd ../.. vitest run --config vitest.config.ts packages/rules-runtime/src"
  },
  "dependencies": {
    "@artificer-toolkit/schema": "workspace:^",
    "@artificer-toolkit/shared": "workspace:^",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@artificer-toolkit/source-data": "workspace:^",
    "typescript": "^7.0.2"
  }
}
