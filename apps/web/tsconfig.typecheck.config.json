{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": true,
    "noEmit": true,
    "tsBuildInfoFile": ".cache/tsc/typecheck.config.tsbuildinfo",
    "types": [
      "vite/client",
      "node",
      "vitest/globals",
      "vitest/browser",
      "@testing-library/jest-dom"
    ]
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.browser.config.ts",
    "playwright*.config.ts",
    "tests/**/*.ts",
    "vite-env.d.ts"
  ]
}
