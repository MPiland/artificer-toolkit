{
	"folders": [
		{
			"path": "."
		}
	],
	"settings": {
		"typescript.tsserver.maxTsServerMemory": 8192,
		"typescript.experimental.useTsgo": false,
		"editor.experimental.preferTreeSitter.typescript": true,
		"typescript.preferGoToSourceDefinition": true,
		"typescript.tsserver.enableRegionDiagnostics": false,
		"typescript.workspaceSymbols.scope": "dbaeumer.vscode-eslint",
		"typescript.tsserver.web.projectWideIntellisense.enabled": false,
		"typescript.tsserver.web.typeAcquisition.enabled": false,
		"js/ts.hover.maximumLength": 200,
		"SQL-Formatter-VSCode.dialect": "postgresql",
		"editor.codeActionsOnSave": {
			"source.fixAll.eslint": "explicit"
		},
		"eslint.useFlatConfig": true,
		"[typescript]": {
			"editor.defaultFormatter": "dbaeumer.vscode-eslint"
		},
		"[typescriptreact]": {
			"editor.defaultFormatter": "dbaeumer.vscode-eslint"
		},
		"typescript.tsdk": "node_modules\\typescript\\lib",
		"eslint.format.enable": true,
		"editor.formatOnSave": true,
		"editor.defaultFormatter": "dbaeumer.vscode-eslint",
		"typescript.updateImportsOnFileMove.enabled": "always",
		"editor.tabSize": 2
	}
}