{
  "name": "artificer-toolkit",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "yarn workspace @artificer-toolkit/web dev",
    "db:reset:remote": "yarn workspace @artificer-toolkit/db db:reset:remote",
    "audit:srd": "yarn workspace @artificer-toolkit/db audit:srd",
    "seed:owner": "yarn workspace @artificer-toolkit/db seed:owner",
    "seed:srd": "yarn build:shared && yarn workspace @artificer-toolkit/db seed:srd",
    "build:schema": "yarn tsc -p packages/schema/tsconfig.build.json",
    "generate:schema": "yarn workspace @artificer-toolkit/schema generate:zod",
    "build:web": "yarn workspace @artificer-toolkit/web typecheck",
    "typecheck:web:app": "yarn workspace @artificer-toolkit/web typecheck:app",
    "typecheck:web:stories": "yarn workspace @artificer-toolkit/web typecheck:stories",
    "typecheck:web:tests": "yarn workspace @artificer-toolkit/web typecheck:tests",
    "typecheck:web:config": "yarn workspace @artificer-toolkit/web typecheck:config",
    "typecheck:web:diagnostics": "yarn workspace @artificer-toolkit/web typecheck:diagnostics",
    "generate:routes:web": "yarn workspace @artificer-toolkit/web generate:routes",
    "storybook:web": "yarn workspace @artificer-toolkit/web storybook",
    "build-storybook:web": "yarn workspace @artificer-toolkit/web build-storybook",
    "build:apis": "yarn tsc -p apps/apis/tsconfig.build.json",
    "build:shared": "yarn tsc -p packages/shared/tsconfig.build.json",
    "build:db": "yarn tsc -p packages/db/tsconfig.build.json",
    "build:functions": "yarn tsc -p packages/functions/tsconfig.build.json",
    "build:functions:fast": "yarn tsc -p packages/functions/tsconfig.build.json --declarationMap false --sourceMap false",
    "typecheck:functions:services": "yarn tsc -p packages/functions/tsconfig.services.json --pretty false --noEmit",
    "build:functions:verbose": "yarn tsc --build packages/functions/tsconfig.build.json --verbose --extendedDiagnostics",
    "build:all": "yarn build:schema && yarn build:shared && yarn build:db && yarn build:functions",
    "test:shared": "vitest run packages/shared/src/__tests__",
    "test:shared:watch": "vitest packages/shared/src/__tests__",
    "test:schema": "vitest run packages/schema/src/__tests__",
    "test:schema:watch": "vitest packages/schema/src/__tests__",
    "test:db": "vitest run packages/db/src/__tests__",
    "test:db:watch": "vitest packages/db/src/__tests__",
    "test:web": "yarn workspace @artificer-toolkit/web test",
    "test:web:browser": "yarn workspace @artificer-toolkit/web test:browser",
    "test:web:e2e": "yarn workspace @artificer-toolkit/web test:e2e",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:shared": "eslint packages/shared --ext ts",
    "lint:web": "eslint apps/web --ext ts,tsx",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@supabase/supabase-js": "^2.105.3",
    "globals": "^17.6.0",
    "kysely": "^0.28.17"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^25.6.1",
    "eslint": "^10.3.0",
    "gitpick": "^5.4.1",
    "prettier": "^3.8.3",
    "prettier-plugin-sql": "^0.20.0",
    "prettier-plugin-sql-cst": "^0.22.1",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.1.5"
  },
  "packageManager": "yarn@4.11.0+sha512.4e54aeace9141df2f0177c266b05ec50dc044638157dae128c471ba65994ac802122d7ab35bcd9e81641228b7dcf24867d28e750e0bcae8a05277d600008ad54"
}
