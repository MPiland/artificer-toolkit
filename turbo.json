{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": [
    "package.json",
    "yarn.lock",
    ".yarnrc.yml",
    "tsconfig*.json",
    "apps/*/tsconfig*.json",
    "packages/*/tsconfig*.json"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "storybook-static/**", ".output/**"]
    },
    "build-storybook": {
      "dependsOn": ["^build"],
      "outputs": ["storybook-static/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "storybook": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "outputs": []
    },
    "test:authoring": {
      "outputs": []
    },
    "test:coverage": {
      "outputs": ["coverage/**"]
    },
    "test:coverage:storybook": {
      "outputs": ["coverage/**"]
    },
    "test:storybook": {
      "outputs": []
    },
    "test:e2e": {
      "passThroughEnv": [
        "APP_E2E_BASE_URL",
        "CI",
        "MVP_AUDIT_EMAIL",
        "MVP_AUDIT_PASSWORD",
        "MVP_AUDIT_STORAGE_STATE"
      ],
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "test:e2e:authoring-storybook": {
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "test:forms": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": [".cache/tsc/*.tsbuildinfo", "tsconfig*.tsbuildinfo"]
    },
    "typecheck:convex": {
      "dependsOn": [
        "@artificer-toolkit/authoring#build",
        "@artificer-toolkit/encounter-persistence#build",
        "@artificer-toolkit/rules-runtime#build",
        "@artificer-toolkit/schema#build",
        "@artificer-toolkit/emails#build",
        "@artificer-toolkit/source-data#build"
      ],
      "outputs": []
    },
    "test:convex": {
      "dependsOn": [
        "@artificer-toolkit/authoring#build",
        "@artificer-toolkit/encounter-persistence#build",
        "@artificer-toolkit/rules-runtime#build",
        "@artificer-toolkit/schema#build",
        "@artificer-toolkit/emails#build",
        "@artificer-toolkit/source-data#build"
      ],
      "outputs": []
    },
    "typecheck:app": {
      "outputs": [".cache/tsc/typecheck.app.tsbuildinfo"]
    },
    "typecheck:config": {
      "outputs": [".cache/tsc/typecheck.config.tsbuildinfo"]
    },
    "typecheck:stories": {
      "outputs": [".cache/tsc/typecheck.stories.tsbuildinfo"]
    },
    "typecheck:tests": {
      "outputs": [".cache/tsc/typecheck.tests*.tsbuildinfo"]
    }
  }
}
