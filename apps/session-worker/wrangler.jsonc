{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "artificer-live-session",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "keep_vars": true,
  "routes": [
    {
      "pattern": "tabletop.artificertoolkit.app",
      "custom_domain": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "LIVE_SESSION_ROOMS",
        "class_name": "LiveSessionRoom"
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "CONTENT_SNAPSHOTS",
      "bucket_name": "artificer-content-snapshots"
    }
  ],
  "exports": {
    "LiveSessionRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "env": {
    "staging": {
      "name": "artificer-live-session-staging",
      "routes": [
        {
          "pattern": "tabletop-staging.artificertoolkit.app",
          "custom_domain": true
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "LIVE_SESSION_ROOMS",
            "class_name": "LiveSessionRoom"
          }
        ]
      },
      "r2_buckets": [
        {
          "binding": "CONTENT_SNAPSHOTS",
          "bucket_name": "artificer-content-snapshots-staging"
        }
      ],
      "vars": {
        "LIVE_SESSION_ALLOWED_ORIGINS": "https://deploy-preview-76--cerulean-sorbet-c62c71.netlify.app"
      }
    }
  }
}
