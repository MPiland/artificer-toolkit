{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "stripInternal": true,
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["dist", "src/**/*.test.ts"]
}
