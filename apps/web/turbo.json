{
  "extends": ["//"],
  "tasks": {
    "build": {
      "env": ["LIBRARY_IMPORT_ENABLED", "PUBLIC_SIGN_UP_ENABLED"],
      "passThroughEnv": [
        "DATABASE_CONNECTION_STRING",
        "SENTRY_AUTH_TOKEN",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "SUPABASE_SECRET_KEY",
        "SUPABASE_URL"
      ]
    },
    "dev": {
      "passThroughEnv": [
        "DATABASE_CONNECTION_STRING",
        "DATABASE_URL",
        "SUPABASE_SECRET_KEY",
        "SUPABASE_URL"
      ]
    }
  }
}
