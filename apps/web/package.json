{
  "name": "@artificer-toolkit/web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "generate-routes": "tsr generate",
    "watch-routes": "tsr watch",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "yarn generate-routes && yarn typecheck:app",
    "typecheck:app": "node --max-old-space-size=8192 ../../node_modules/typescript/bin/tsc -p tsconfig.typecheck.app.json --pretty false",
    "typecheck:stories": "node --max-old-space-size=8192 ../../node_modules/typescript/bin/tsc -p tsconfig.typecheck.stories.json --pretty false",
    "typecheck:tests": "node --max-old-space-size=8192 ../../node_modules/typescript/bin/tsc -p tsconfig.typecheck.tests.json --pretty false",
    "typecheck:config": "node --max-old-space-size=8192 ../../node_modules/typescript/bin/tsc -p tsconfig.typecheck.config.json --pretty false",
    "typecheck:diagnostics": "node --max-old-space-size=8192 ../../node_modules/typescript/bin/tsc -p tsconfig.typecheck.app.json --extendedDiagnostics --pretty false",
    "test": "vitest run --config vitest.config.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "storybook": "storybook dev -p 6006 --ci",
    "build-storybook": "storybook build",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:storybook": "playwright test --project=storybook",
    "test:e2e:app": "playwright test --project=app"
  },
  "dependencies": {
    "@artificer-toolkit/apis": "workspace:",
    "@artificer-toolkit/db": "workspace:^",
    "@artificer-toolkit/shared": "workspace:^",
    "@mantine/core": "^9.1.1",
    "@mantine/hooks": "^9.1.1",
    "@mantine/notifications": "^9.1.1",
    "@mantine/tiptap": "^9.1.1",
    "@storybook/addon-docs": "^10.3.6",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.3",
    "@tabler/icons-react": "^3.43.0",
    "@tanstack/react-form": "^1.29.1",
    "@tanstack/react-query": "^5.100.9",
    "@tanstack/react-query-devtools": "^5.100.9",
    "@tanstack/react-router": "^1.169.2",
    "@tanstack/react-router-devtools": "^1.166.13",
    "@tanstack/react-router-ssr-query": "^1.166.12",
    "@tanstack/react-virtual": "^3.13.24",
    "@tiptap/core": "^3.22.5",
    "@tiptap/extension-link": "^3.22.5",
    "@tiptap/extension-placeholder": "3.22.5",
    "@tiptap/extension-subscript": "3.22.5",
    "@tiptap/extension-superscript": "3.22.5",
    "@tiptap/extension-table": "3.22.5",
    "@tiptap/extension-table-cell": "3.22.5",
    "@tiptap/extension-table-header": "3.22.5",
    "@tiptap/extension-table-row": "3.22.5",
    "@tiptap/extension-text-align": "3.22.5",
    "@tiptap/extension-underline": "3.22.5",
    "@tiptap/extensions": "3.22.5",
    "@tiptap/pm": "^3.22.5",
    "@tiptap/react": "^3.22.5",
    "@tiptap/starter-kit": "3.22.5",
    "@trpc/client": "^11.17.0",
    "@trpc/server": "^11.17.0",
    "@vanilla-extract/css": "^1.20.1",
    "@vanilla-extract/recipes": "^0.5.7",
    "@vanilla-extract/sprinkles": "^1.6.5",
    "clsx": "^2.1.1",
    "html-react-parser": "^6.1.0",
    "lucide-react": "^1.14.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@mantine/vanilla-extract": "^9.1.1",
    "@playwright/test": "^1.59.1",
    "@storybook/addon-a11y": "^10.3.6",
    "@storybook/addon-mcp": "^0.6.0",
    "@storybook/addon-themes": "^10.3.6",
    "@storybook/react-vite": "^10.3.6",
    "@tanstack/query-core": "^5.100.9",
    "@tanstack/react-start": "^1.167.65",
    "@tanstack/router-cli": "^1.166.43",
    "@tanstack/router-core": "^1.169.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vanilla-extract/vite-plugin": "^5.2.2",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser": "^4.1.5",
    "@vitest/browser-playwright": "^4.1.5",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-storybook": "10.3.6",
    "jsdom": "^29.1.1",
    "msw": "^2.14.4",
    "msw-storybook-addon": "^2.0.7",
    "playwright": "^1.59.1",
    "postcss": "^8.5.14",
    "postcss-preset-mantine": "^1.18.0",
    "storybook": "^10.3.6",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "vitest": "^4.1.5"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
