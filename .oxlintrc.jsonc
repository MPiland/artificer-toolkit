{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "node_modules/**",
    ".yarn/**",
    ".codex/**",
    ".agents/**",
    ".claude/**",
    ".cursor/**",
    "dist/**",
    "dist-ssr/**",
    "storybook-static/**",
    "apps/**/dist/**",
    "apps/**/.wrangler/**",
    "apps/**/storybook-static/**",
    "test-results/**",
    "playwright-report/**",
    "**/*.d.ts",
    "**/routeTree.gen.ts"
  ],
  "plugins": ["eslint", "typescript", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "options": {
    "maxWarnings": 0
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "settings": {
    "react": {
      "version": "19.2.6"
    }
  },
  "rules": {
    "no-unused-vars": [
      "error",
      { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "ignoreRestSiblings": true }
    ],
    "no-await-in-loop": "off",
    "no-underscore-dangle": "off",
    "typescript/no-explicit-any": "error",
    "unicorn/no-array-sort": "off",
    "react/react-in-jsx-scope": "off",
    "react/rules-of-hooks": "error"
  },
  "overrides": [
    {
      // Fast Refresh: component files export components only (AGENTS.md). Route modules export `Route`.
      // Enabling the react plugin here also enables its correctness rules; the ones still red are off
      // until they are adopted with their own cleanup.
      "files": [
        "apps/web/src/**/*.tsx",
        "packages/design-system/src/**/*.tsx",
        "packages/emails/src/**/*.tsx"
      ],
      "excludeFiles": [
        "apps/web/src/routes/**",
        "**/*.test.tsx",
        "**/*.stories.tsx",
        "**/__tests__/**",
        "**/test/**"
      ],
      "plugins": ["react"],
      "rules": {
        "react/only-export-components": ["error", { "customHOCs": ["withForm", "withFieldGroup"] }],
        "react/globals": "off",
        "react/incompatible-library": "off",
        "react/jsx-key": "off",
        "react/preserve-manual-memoization": "off",
        "react/purity": "error",
        "react/refs": "error",
        "react/set-state-in-effect": "error",
        "react-hooks/exhaustive-deps": "off"
      }
    },
    {
      "files": ["apps/apis/convex/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "convex/server",
                "importNames": ["mutationGeneric", "internalMutationGeneric"],
                "message": "Use lib/mutations so Scene vision dependencies advance transactionally."
              }
            ],
            "patterns": [
              {
                "group": ["**/_generated/server", "**/_generated/server.js"],
                "importNames": ["mutation", "internalMutation"],
                "message": "Use lib/mutations so Scene vision dependencies advance transactionally."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@artificer-toolkit/shared/account/usernameServer",
                "message": "The username dictionary is server-only; the web bundle uses account/username."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/apis/convex/lib/mutations.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["packages/shared/src/domains/**/maps/**/*.ts"],
      "rules": {
        "typescript/unbound-method": "off"
      }
    }
  ]
}
