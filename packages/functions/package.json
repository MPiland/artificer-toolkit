{
  "name": "@artificer-toolkit/functions",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#services": {
      "types": "./dist/services/index.d.ts",
      "default": "./dist/services/index.js"
    },
    "#runtime": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    },
    "#utils": {
      "types": "./dist/utils/index.d.ts",
      "default": "./dist/utils/index.js"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "default": "./dist/*/index.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsc -p tsconfig.build.json",
    "test": "yarn --cwd ../.. vitest run --config vitest.config.ts packages/functions/src",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "@artificer-toolkit/db": "workspace:^",
    "@artificer-toolkit/schema": "workspace:^",
    "@artificer-toolkit/shared": "workspace:^",
    "@supabase/supabase-js": "^2.108.2"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
