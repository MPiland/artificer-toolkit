{
  "name": "artificer-toolkit",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "yarn workspace @artificer-toolkit/web dev",
    "build:web": "yarn tsc -p apps/web/tsconfig.build.json",
    "build:apis": "yarn tsc -p apps/apis/tsconfig.build.json",
    "build:shared": "yarn tsc -p packages/shared/tsconfig.build.json",
    "build:db": "yarn tsc -p packages/db/tsconfig.build.json",
    "build:functions": "yarn tsc -p packages/functions/tsconfig.build.json",
    "build:all": "yarn build:shared && yarn build:db && yarn build:functions",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:shared": "eslint packages/shared --ext ts",
    "lint:web": "eslint apps/web --ext ts,tsx",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.87.1",
    "kysely": "^0.28.8"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.6.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "gitpick": "^4.12.4",
    "prettier": "^3.6.2",
    "prettier-plugin-sql": "^0.19.2",
    "prettier-plugin-sql-cst": "^0.13.0",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  },
  "packageManager": "yarn@4.11.0+sha512.4e54aeace9141df2f0177c266b05ec50dc044638157dae128c471ba65994ac802122d7ab35bcd9e81641228b7dcf24867d28e750e0bcae8a05277d600008ad54"
}
