{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": [
      "vite/client",
      "node"
    ]
  },
  "include": [
    "src/app/**/*",
    "src/css/**/*",
    "src/router.tsx",
    "src/routes/**/*",
    "src/server.ts",
    "src/supabase/**/*",
    "vite-env.d.ts"
  ],
  "exclude": [
    "src/**/*.stories.ts",
    "src/**/*.stories.tsx",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/stories/**/*",
    "src/**/tests/**/*",
    "src/legacy/**/*",
    "src/test/**/*",
    "src/utils/**/*"
  ]
}
