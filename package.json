{
  "name": "artificer-toolkit",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "yarn workspace @artificer/web dev",
    "build": "yarn workspace @artificer/web build",
    "build:shared": "yarn workspace @artificer/shared build",
    "build:db": "yarn workspace @artificer/db build",
    "build:functions": "yarn workspace @artificer/functions build",
    "build:all": "yarn build:shared && yarn build:db && yarn build:functions",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:shared": "eslint packages/shared --ext ts",
    "lint:web": "eslint apps/web --ext ts,tsx",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.6.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "gitpick": "^4.12.4",
    "prettier": "^3.6.2",
    "prettier-plugin-sql": "^0.19.2",
    "prettier-plugin-sql-cst": "^0.13.0",
    "rimraf": "^6.0.1",
    "supabase": "^2.65.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.4",
    "typescript": "^6.0.0-dev.20251204",
    "typescript-eslint": "^8.46.4"
  },
  "packageManager": "yarn@4.11.0+sha512.4e54aeace9141df2f0177c266b05ec50dc044638157dae128c471ba65994ac802122d7ab35bcd9e81641228b7dcf24867d28e750e0bcae8a05277d600008ad54"
}
