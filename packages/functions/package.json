{
  "name": "@artificer-toolkit/functions",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#services": {
      "types": "./dist/services/index.d.ts",
      "default": "./dist/services/index.js"
    },
    "#runtime": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    },
    "#utils": {
      "types": "./dist/utils/index.d.ts",
      "default": "./dist/utils/index.js"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "default": "./dist/*/index.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsc -p tsconfig.build.json --noCheck",
    "test": "yarn --cwd ../.. vitest run --config vitest.config.ts packages/functions/src --pool=forks --maxWorkers=1 --no-file-parallelism",
    "measure:encounter-actor-policy": "tsx src/scripts/measureEncounterActorPolicy.ts",
    "generate:srd:rule-path-manifest": "tsx src/scripts/generateSrdRulePathManifest.ts",
    "verify:srd:rule-path-manifest": "tsx src/scripts/verifySrdRulePathManifest.ts",
    "projections:verify:authored:local": "tsx src/scripts/verifyAuthoredProjections.ts --local",
    "projections:verify:authored:staging": "tsx src/scripts/verifyAuthoredProjections.ts --staging",
    "projections:verify:authored:production": "tsx src/scripts/verifyAuthoredProjections.ts --production",
    "projections:verify:characters:local": "tsx src/scripts/verifyCharacterMechanicsProjections.ts --local",
    "projections:verify:characters:staging": "tsx src/scripts/verifyCharacterMechanicsProjections.ts --staging",
    "projections:verify:characters:production": "tsx src/scripts/verifyCharacterMechanicsProjections.ts --production",
    "provision:vtt-managed-smoke:staging": "tsx src/scripts/provisionManagedVttSmoke.ts --staging",
    "provision:vtt-managed-smoke:production": "tsx src/scripts/provisionManagedVttSmoke.ts --production",
    "provision:vtt-managed-smoke:local": "tsx src/scripts/provisionManagedVttSmoke.ts --local",
    "test:vtt-map:integration": "tsx src/scripts/testVttMapMediaIntegration.ts",
    "seed:canonical-rule-packs:local": "tsx src/scripts/seedCanonicalRulePacks.ts --local",
    "seed:canonical-rule-packs:staging": "tsx src/scripts/seedCanonicalRulePacks.ts --staging",
    "seed:canonical-rule-packs:production": "tsx src/scripts/seedCanonicalRulePacks.ts --production",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "@artificer-toolkit/db": "workspace:^",
    "@artificer-toolkit/emails": "workspace:^",
    "@artificer-toolkit/schema": "workspace:^",
    "@artificer-toolkit/shared": "workspace:^",
    "@gorules/zen-engine": "0.54.0",
    "@supabase/supabase-js": "^2.108.2",
    "aws4fetch": "1.0.20",
    "jose": "^6.2.4",
    "sharp": "^0.35.3",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "tsx": "^4.22.4",
    "typescript": "^7.0.2"
  }
}
