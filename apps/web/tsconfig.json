{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "types": [
      "vite/client"
    ],
    "noEmit": true,
    "useDefineForClassFields": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "paths": {
      "@auth": [
        "./src/domains/auth"
      ],
      "@css/*": [
        "./src/css/*"
      ],
      "@components/*": [
        "./src/components/*"
      ],
      "@pages/*": [
        "./src/domains/*"
      ],
      "@enums/*": [
        "./src/enums/*"
      ],
      "@hooks": [
        "./src/hooks"
      ],
      "@utils/*": [
        "./src/utils/*"
      ],
      "@routes/*": [
        "./src/routes/*"
      ],
      "@assets/*": [
        "./src/assets/*"
      ],
      "@theme/*": [
        "./src/theme/*"
      ],
      "@store": [
        "./src/store"
      ],
      "@server/*": [
        "./src/server/*"
      ],
      "@supabase": [
        "./src/supabase"
      ],
      "@utils": [
        "./src/utils"
      ],
      "@data/*": [
        "./src/data/*"
      ],
      "@types": [
        "./src/types"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts",
    "vite-env.d.ts",
    "server/auth/serverFns.tsx"
  ]
}
